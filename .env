# ============================================================================
# ML OPTIMIZED CONFIGURATION - V8 ML Strategy
# Based on LightGBM Model with 121 Features
# Threshold Optimized: 0.56
# Performance: £2,468 profit (+24.7% return) over 1.2 years
# Win Rate: 53.3% | Profit Factor: 1.37 | Max DD: 1.83%
# Last Updated: 2025-12-30
# ============================================================================

# API CREDENTIALS (REQUIRED FOR LIVE TRADING)
API_KEY=
API_SECRET=
# TRADING SYMBOLS (6 coins used in ML training)
SYMBOLS=BTC/USDT,ETH/USDT,BNB/USDT,SOL/USDT
QUOTE=USDT
CONFIRM_LIVE=true
# POSITION SIZING
POSITION_USD=15
POSITION_PCT=0.0
MIN_POSITION_USD=5

# TIMEFRAME (ML trained on 1h data)
TIMEFRAME=1h
POLL_SECONDS=60

# ============================================================================
# ML STRATEGY PARAMETERS (OPTIMIZED)
# ============================================================================

# ML Model Configuration (Time-Enhanced Model with 99 features)
ML_MODEL_PATH=models/LightGBM_Robust_20260112_090713.json
ML_PROBABILITY_THRESHOLD=0.56
ML_AVAILABLE=true

# Risk/Reward Configuration (1.5:1 RR Ratio)
ML_RR_RATIO=1.5
ML_ATR_MULTIPLIER=2.0
ML_ATR_PERIOD=14

# Entry Filter (set to "None" for threshold-only filtering)
ML_ENTRY_FILTER=None

# Transaction Costs
FEE_PCT=0.001
SLIPPAGE_PCT=0.0005

# ============================================================================
# TECHNICAL INDICATORS (Used by ML model - keep for feature generation)
# ============================================================================

# RSI Parameters
RSI_PERIOD=14
RSI_THRESHOLD=30

# EMA Parameters
EMA_FAST=12
EMA_SLOW=26
EMA_9=9
EMA_20=20
EMA_50=50
EMA_100=100
EMA_200=200

# ATR Parameters
ATR_PERIOD=14
ATR_MULT=2.0

# Bollinger Bands
BB_PERIOD=20
BB_WIDTH_MIN=0.015

# Volume
VOLUME_MULT=1.5

# ============================================================================
# STOP LOSS & TAKE PROFIT (ML Strategy)
# ============================================================================

# Stop Loss: Entry - (1.5 × ATR)
CHANDELIER_MULT=2.0

# Take Profit: Entry + (2.25 × ATR) for 1.5:1 RR
TAKE_RATIO=1.5
TP_PCT=0.0

# Trailing Stop
PERCENT_TRAIL=0.0

# ATR Adaptive Settings
ATR_ADAPTIVE_ENABLED=true
ATR_ADAPTIVE_REDUCTION=0.2
ATR_BUFFER_MULT=0.3

# ============================================================================
# OTHER SETTINGS
# ============================================================================

# Strategy Selection (cycle1/cycle2/rsi_momentum/cycle4)
RUN_CYCLE_STRATEGY=cycle4

# Trading Mode
DRY_RUN=false
NOTIFY=true

# Cooldown (reduced for higher frequency)
COOLDOWN_SECONDS=300

# Position Management
BUY_WINDOW_CANDLES=10

# ============================================================================
# PERFORMANCE METRICS (From Backtest)
# ============================================================================
# Total Trades: 625 (521/year)
# Win Rate: 53.3%
# Avg Win: £27.27
# Avg Loss: £22.65
# Profit Factor: 1.37
# Max Drawdown: 1.83%
# Sharpe Ratio: 2.51
